{
  "manifest_version": 3,
  "name": "AI Prompt Image Metadata",
  "version": "1.21",
  "description": "Local-only bootstrap build for prompt-associated image metadata.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AI Prompt Image Metadata",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://grok.com/*"],
      "js": ["content.js"]
    }
  ],
  "permissions": ["storage", "downloads", "offscreen"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-download-capture.js"],
      "matches": ["https://gemini.google.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "offscreen": {
    "path": "offscreen.html",
    "reason": "BLOBS"
  }
}

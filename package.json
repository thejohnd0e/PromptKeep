{
  "name": "ai-prompt-image-metadata",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:eagle": "node scripts/build.mjs eagle",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src eagle-plugin tests vite.config.ts vitest.config.ts playwright.config.ts",
    "test:unit": "vitest run tests/unit",
    "test:property": "vitest run tests/property --passWithNoTests",
    "test:compat": "vitest run tests/compat --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:eagle": "vitest run tests/eagle --passWithNoTests",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:eagle-package": "node scripts/verify-eagle-package.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:property && npm run test:compat && npm run build && npm run test:e2e && npm run test:eagle && npm run verify:workspace"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "fast-check": "4.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-node": "6.0.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "saxes": "6.0.0",
    "zod": "4.6.4"
  }
}
